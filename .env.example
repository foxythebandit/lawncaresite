# Local settings. `npm run db:start` copies this file to .env.local and fills in the Supabase lines.
# Nothing here is a real key. Never put production values in .env.local: `npm run dev` refuses them.

# Filled in by `npm run db:start`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Who can use /admin. Must match a login in supabase/seed.sql.
STAFF_EMAILS=staff@example.test
# Address of this running site, used in links.
CRM_BASE_URL=http://localhost:3000

# Email. Leave both blank and the app says "email not configured".
# If you set RESEND_API_KEY, EMAIL_DEV_RECIPIENT is required: every email then goes to that one address, never to customers.
RESEND_API_KEY=
EMAIL_DEV_RECIPIENT=

# Texts and calls. `npm run db:start` always blanks TWILIO_AUTH_TOKEN, so local never texts or calls anyone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STAFF_PHONES=
TWILIO_VERIFIED_CALLER_IDS=
STAFF_PEOPLE=
STAFF_SMS_ENABLED=false
STAFF_VOICE_ENABLED=false
CONNECT_MODE=twilio

# Payments. Stripe test key only (sk_test_...). `npm run dev` refuses a live key.
STRIPE_SECRET_KEY=

# Maps and address lookup. Optional: without them the map shows satellite imagery only and parcel lookup is off.
NEXT_PUBLIC_MAPBOX_TOKEN=
REGRID_TOKEN=

# Webhook and job secrets. Any made-up value works locally.
INTAKE_WEBHOOK_SECRET=
CONVIFLO_WEBHOOK_SECRET=
CONVIFLO_FORMS=
ALERT_RECOVERY_SECRET=
CRON_SECRET=

# Ads. Leave blank locally.
GOOGLE_ADS_FEED_USER=
GOOGLE_ADS_FEED_PASSWORD=
META_AD_CREATIVES=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_LEAD_EVENTS_ENABLED=
NEXT_PUBLIC_META_UTM_ID_CAMPAIGNS=
